# Dependencies — never commit. Native binaries are platform-specific
# (@rollup/rollup-win32-*, @esbuild/win32-*) and Git drops the Unix
# executable bit, which breaks Linux CI builds.
node_modules/

# Build output — regenerated by `npm run build`
dist/

# Local env — contains NEWSAPI_KEY
.env
.env.local
.env.*.local

# Netlify CLI
.netlify/

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Claude Code local settings
.claude/settings.local.json
